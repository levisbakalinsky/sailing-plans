#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - gnupg

write_files:
  - path: /opt/sailing-plans/docker-compose.yml
    permissions: "0644"
    encoding: b64
    content: ${compose_yaml_b64}

  - path: /opt/sailing-plans/Caddyfile
    permissions: "0644"
    encoding: b64
    content: ${caddyfile_b64}

  - path: /opt/sailing-plans/.env
    permissions: "0600"
    encoding: b64
    content: ${env_file_b64}

  - path: /opt/sailing-plans/boot-app.sh
    permissions: "0755"
    encoding: b64
    content: ${boot_script_b64}

runcmd:
  - [bash, /opt/sailing-plans/boot-app.sh]
