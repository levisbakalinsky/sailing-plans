# Local defaults — see docs/infrastructure.md for DigitalOcean / production wiring.
PORT=3001
NODE_ENV=development

# PostgreSQL (local or DigitalOcean Managed).
# On App Platform this is bound from the sailing-plans-db component:
#   DATABASE_URL=${sailing-plans-db.DATABASE_URL}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sailing_plans?schema=public"

# Clerk (replace with real keys from the Clerk dashboard before enabling auth).
CLERK_SECRET_KEY="sk_test_replace_me"
CLERK_PUBLISHABLE_KEY="pk_test_replace_me"

# Cloudflare — reserved for later (CDN / edge in front of App Platform).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
