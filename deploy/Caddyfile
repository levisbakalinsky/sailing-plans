# Alternate TLDs → canonical (defense in depth; Cloudflare Page Rules also redirect).
sailingplans.net, www.sailingplans.net, sailingplans.org, www.sailingplans.org {
	redir https://sailingplans.com{uri} permanent
}

# Public site + LB health checks (Host may be IP or sailingplans.com).
sailingplans.com, www.sailingplans.com, :80 {
	encode gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
