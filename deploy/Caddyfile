{
	# TLS terminates at Cloudflare (Flexible). Origin speaks plain HTTP.
	auto_https off
}

# Alternate TLDs → canonical (defense in depth; Cloudflare Single Redirects also redirect).
http://sailingplans.net, http://www.sailingplans.net, http://sailingplans.org, http://www.sailingplans.org {
	redir https://sailingplans.com{uri} permanent
}

# Public site + LB health checks (Host may be IP or sailingplans.com).
:80 {
	encode gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8080
	}

	handle /health {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
